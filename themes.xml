<resources>
    <style name="Theme.ParkOnSpot" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/park_blue</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorSecondary">@color/park_green</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:windowBackground">@color/park_bg</item>
        <item name="android:statusBarColor">@color/park_blue_dark</item>
    </style>
    <style name="TicketLabel">
        <item name="android:textSize">11sp</item>
        <item name="android:textColor">@color/park_muted</item>
        <item name="android:textStyle">bold</item>
    </style>
    <style name="TicketValue">
        <item name="android:textSize">16sp</item>
        <item name="android:textColor">@color/park_text</item>
    </style>
</resources>