<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android" xmlns:app="http://schemas.android.com/apk/res-auto" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" app:cardCornerRadius="12dp" app:cardElevation="2dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:padding="14dp">
        <TextView android:id="@+id/tvFreePlate" android:layout_width="match_parent" android:layout_height="wrap_content" android:textColor="@color/park_text" android:textSize="15sp" android:textStyle="bold"/>
        <TextView android:id="@+id/tvFreeInfo" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="@color/park_muted"/>
        <com.google.android.material.button.MaterialButton android:id="@+id/btnEndFree" style="@style/Widget.Material3.Button.OutlinedButton" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="end" android:layout_marginTop="6dp" android:text="Leave / end parking"/>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>